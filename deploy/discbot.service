# systemd unit for the bot; deploy/setup.sh fills in __USER__ and __REPO__.
# Linux counterpart of scripts/run_bot.cmd: restarts 15 s after a crash, starts on boot.
[Unit]
Description=DiscBot (Discord bot)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__REPO__
ExecStart=__REPO__/.venv/bin/python bot.py
Environment=PYTHONUTF8=1 PYTHONUNBUFFERED=1
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
